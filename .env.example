# ===== 大模型配置（OpenAI 兼容接口）=====
# 复制本文件为 .env 并填入真实值
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-pro
API_KEY=your_api_key_here
BASE_URL=https://api.deepseek.com/v1

# 可选：请求超时（秒）与最大重试次数
REQUEST_TIMEOUT=60
MAX_RETRIES=1

# 可选：是否启用 mock 降级模式（true/false）
ENABLE_MOCK=false

# 500-table simulation. Existing API credentials are not changed.
PROJECT_PROFILE=petkit
PETKIT_MODE=demo
PETKIT_QUERY_SECONDS=15
# Optional local model folder, no automatic model download:
# PETKIT_EMBEDDING_MODEL=D:/models/bge-m3
# For llm mode, configure server-side bearer token -> identity mapping:
# PETKIT_API_TOKENS={"replace-with-random-secret":{"subject":"analyst-01","role":"analyst"}}

# DeepSeek-only generation: disabled avoids spending the small query budget on reasoning.
PETKIT_THINKING=disabled
