# Values injected by Secret. This file contains names, never working credentials.
APP_ENV=production
QUERY_ENGINE=starrocks
ENTERPRISE_TENANT_ID=petkit
LINGXI_DATABASE_URL=postgresql://RUNTIME_USER:SECRET@PG_HOST/analytics?sslmode=verify-full&sslrootcert=/run/certs/pg-ca.pem
OIDC_ISSUER=https://SSO_ISSUER
OIDC_AUDIENCE=analytics
OIDC_CLIENT_ID=analytics-resource-server
OIDC_BROWSER_CLIENT_ID=analytics-portal
OIDC_CLIENT_SECRET=SECRET
OIDC_INTROSPECTION_URL=https://SSO_INTROSPECTION_ENDPOINT
MODEL_GATEWAY_URL=https://INTRANET_GATEWAY/v1
MODEL_GATEWAY_KEY=SECRET
STARROCKS_SCOPES_JSON={"global":{"host":"SR_FE","port":9030,"database":"analytics","user":"analytics_global_reader","regions":[],"password_env":"SR_GLOBAL_PASSWORD","ssl_ca":"/run/certs/sr-ca.pem"}}
SR_GLOBAL_PASSWORD=SECRET
LINGXI_ENABLED_METRICS=["net_sales","tickets","inventory","received_units"]
# Both revisions must be verified against the real gateway deployment, not inferred from aliases.
MODEL_REVISION=REPLACE_WITH_QWEN_27B_WEIGHT_REVISION
# Private gateway embedding-default must be BAAI/bge-m3, 1024D, immutable revision.
EMBEDDING_REVISION=REPLACE_WITH_BGE_M3_WEIGHT_REVISION
OIDC_AUTHORIZATION_ENDPOINT=https://SSO_AUTHORIZATION_ENDPOINT
OIDC_TOKEN_ENDPOINT=https://SSO_TOKEN_ENDPOINT

# Optional P2 reviewer uses a separately approved private gateway alias/revision.
LINGXI_REVIEW_MODE=disabled
LINGXI_REVIEW_ALIAS=
LINGXI_REVIEW_REVISION=
LINGXI_REVIEW_SECONDS=10
LINGXI_REVIEW_APPROVAL=

# Production requires a separate >=32-character random monitoring-only Secret.
# It is rejected on all business endpoints; do not reuse gateway/SSO secrets.
LINGXI_METRICS_TOKEN=REPLACE_WITH_DEDICATED_MONITORING_SECRET
