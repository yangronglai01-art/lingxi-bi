      "title": "Source",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "title": "Batch Id",
      "type": "string"
    },
    "events": {
      "items": {
        "discriminator": {
          "mapping": {
            "device.activated": "#/$defs/Activation",
            "order.paid": "#/$defs/PaidOrder",
            "order.shipped": "#/$defs/Shipment",
            "purchase.created": "#/$defs/Purchase",
            "purchase.received": "#/$defs/Receipt",
            "refund.created": "#/$defs/Refund",
            "ticket.created": "#/$defs/Ticket"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/Refund"
          },
          {
            "$ref": "#/$defs/Activation"
          },
          {
            "$ref": "#/$defs/Ticket"
          },
          {
            "$ref": "#/$defs/PaidOrder"
          },
          {
            "$ref": "#/$defs/Shipment"
