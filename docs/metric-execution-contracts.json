    {
      "schema_version": "metric-execution-v1",
      "metric": "net_sales",
      "metric_version": "petkit-v1.3",
      "definition": "订单行实付减截至数据截止日该行退款；退款归属原订单支付日；元人民币，不做税额拆分",
      "unit": "CNY",
      "time_column": "fact_order.paid_date",
      "time_range": {
        "kind": "published_snapshot",
        "start": null,
        "end_exclusive": null,
        "as_of": "2026-10-16",
        "assumption": "未指定月份时使用发布快照内全部观察记录，非默认本月"
      },
      "grain": "order item; refunds aggregated by item_id before LEFT JOIN",
      "formula": "SUM(order_item.amount - COALESCE(refunds_by_item.refunded, 0))",
      "rules": [
        "退款截至快照日累计，归原支付月；不按退款发生月归属",
        "退款先按item_id求和再LEFT JOIN，禁止直接关联多条退款或SUM(DISTINCT amount)",
        "模板使用发布快照内全部订单；订单取消/支付状态的源纳入规则需Owner批准，不能自行添加过滤"
      ],
      "group": "channel",
      "dependencies": [
        "fact_order",
        "fact_order_item",
        "fact_refund",
        "dim_sku",
        "dim_product",
        "dim_channel"
      ],
      "output_metrics": [
        "net_sales"
      ],
      "zero_denominator": "not_applicable",
      "empty_result": "empty rows; never replace errors with zero",
      "business_approval_status": "technical_contract_only",
      "sha256": "3b4012a76a4ba4b9da576af0ce53332d51880fe645237d5046c27564e63d1cbf"
    },
