    {
      "schema_version": "metric-execution-v1",
      "metric": "activation30",
      "metric_version": "petkit-v1.3",
      "definition": "截至2026-10-16观察满30天的售出设备，支付日起0至30天激活的设备数/该批设备数；含后续退款设备",
      "unit": "percent",
      "time_column": "fact_order.paid_date",
      "time_range": {
        "kind": "published_snapshot",
        "start": null,
        "end_exclusive": null,
        "as_of": "2026-10-16",
        "assumption": "未指定月份时使用发布快照内全部观察记录，非默认本月"
      },
      "grain": "distinct sold device in mature cohort",
      "formula": "100 * distinct activated devices / distinct mature sold devices",
      "rules": [
        "支付日起0至30天（两端含）激活；只纳入观察满30天的售出设备",
        "分母保留无事件、晚激活和后续退款设备；按device_id去重",
        "事件窗口放在ON或独立outcomes CTE，不得在LEFT JOIN后WHERE缩小分母"
      ],
      "group": "model",
      "dependencies": [
        "fact_order",
        "fact_order_item",
        "bridge_order_device",
        "dim_device",
        "dim_product",
        "fact_device_activation"
      ],
      "output_metrics": [
        "devices",
        "matched_devices",
        "rate_percent"
      ],
