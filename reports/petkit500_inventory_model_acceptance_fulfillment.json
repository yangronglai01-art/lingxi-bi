    "truncated": false,
    "question": "按每个SKU和仓库各自最新快照，汇总各产品型号的期末库存数量，不要跨日期累加库存。",
    "sql": "WITH \"latest_snapshot\" AS (SELECT \"fact_inventory_day\".\"sku_id\" AS \"sku_id\", \"fact_inventory_day\".\"warehouse_id\" AS \"warehouse_id\", MAX(\"fact_inventory_day\".\"stock_date\") AS \"max_date\" FROM \"fact_inventory_day\" AS \"fact_inventory_day\" GROUP BY \"fact_inventory_day\".\"sku_id\", \"fact_inventory_day\".\"warehouse_id\"), \"latest_inventory\" AS (SELECT \"f\".\"sku_id\" AS \"sku_id\", \"f\".\"warehouse_id\" AS \"warehouse_id\", \"f\".\"quantity\" AS \"quantity\" FROM \"fact_inventory_day\" AS \"f\" JOIN \"latest_snapshot\" AS \"ls\" ON \"f\".\"sku_id\" = \"ls\".\"sku_id\" AND \"f\".\"warehouse_id\" = \"ls\".\"warehouse_id\" AND \"f\".\"stock_date\" = \"ls\".\"max_date\") SELECT \"p\".\"product_id\" AS \"product_id\", SUM(\"li\".\"quantity\") AS \"total_quantity\" FROM \"latest_inventory\" AS \"li\" JOIN \"dim_sku\" AS \"s\" ON \"li\".\"sku_id\" = \"s\".\"sku_id\" JOIN \"dim_product\" AS \"p\" ON \"s\".\"product_id\" = \"p\".\"product_id\" GROUP BY \"p\".\"product_id\" ORDER BY \"product_id\" LIMIT 1001",
