        "truncated": false,
        "question": "各型号售出30天激活率",
        "sql": "WITH \"sold_devices\" AS (SELECT \"d\".\"product_id\" AS \"product_id\", \"b\".\"device_id\" AS \"device_id\", \"o\".\"paid_date\" AS \"paid_date\" FROM \"fact_order\" AS \"o\" JOIN \"fact_order_item\" AS \"i\" ON \"o\".\"order_id\" = \"i\".\"order_id\" JOIN \"bridge_order_device\" AS \"b\" ON \"i\".\"item_id\" = \"b\".\"item_id\" JOIN \"dim_device\" AS \"d\" ON \"b\".\"device_id\" = \"d\".\"device_id\" WHERE \"o\".\"paid_date\" <= CAST('2026-09-16' AS DATE)), \"activated_devices\" AS (SELECT \"sd\".\"product_id\" AS \"product_id\", \"sd\".\"device_id\" AS \"device_id\" FROM \"sold_devices\" AS \"sd\" LEFT JOIN \"fact_device_activation\" AS \"a\" ON \"sd\".\"device_id\" = \"a\".\"device_id\" AND \"a\".\"activation_date\" >= \"sd\".\"paid_date\" AND \"a\".\"activation_date\" <= \"sd\".\"paid_date\" + INTERVAL '30' DAY WHERE NOT \"a\".\"device_id\" IS NULL) SELECT \"p\".\"product_id\" AS \"product_id\", \"p\".\"product_name\" AS \"product_name\", COUNT(DISTINCT \"sd\".\"device_id\") AS \"total_sold\", COUNT(DISTINCT \"ad\".\"device_id\") AS \"activated_within_30d\", CASE WHEN COUNT(DISTINCT \"sd\".\"device_id\") = 0 THEN 0 ELSE COUNT(DISTINCT \"ad\".\"device_id\") * 1.0 / COUNT(DISTINCT \"sd\".\"device_id\") END AS \"activation_rate_30d\" FROM \"sold_devices\" AS \"sd\" JOIN \"dim_product\" AS \"p\" ON \"sd\".\"product_id\" = \"p\".\"product_id\" LEFT JOIN \"activated_devices\" AS \"ad\" ON \"sd\".\"product_id\" = \"ad\".\"product_id\" AND \"sd\".\"device_id\" = \"ad\".\"device_id\" GROUP BY \"p\".\"product_id\", \"p\".\"product_name\" ORDER BY \"product_id\" LIMIT 1001",
        "result": {
