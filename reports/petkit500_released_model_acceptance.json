    "truncated": false,
    "question": "请按产品型号列出各型号净销售额，按订单行实付减去对应退款。",
    "sql": "SELECT \"p\".\"product_name\" AS \"product_name\", SUM(\"oi\".\"amount\" - COALESCE(\"r\".\"total_refund\", 0)) AS \"net_sales\" FROM \"fact_order_item\" AS \"oi\" JOIN \"dim_sku\" AS \"s\" ON \"oi\".\"sku_id\" = \"s\".\"sku_id\" JOIN \"dim_product\" AS \"p\" ON \"s\".\"product_id\" = \"p\".\"product_id\" LEFT JOIN (SELECT \"fact_refund\".\"item_id\" AS \"item_id\", SUM(\"fact_refund\".\"amount\") AS \"total_refund\" FROM \"fact_refund\" AS \"fact_refund\" GROUP BY \"fact_refund\".\"item_id\") AS \"r\" ON \"oi\".\"item_id\" = \"r\".\"item_id\" GROUP BY \"p\".\"product_name\" ORDER BY \"product_name\" LIMIT 1001",
