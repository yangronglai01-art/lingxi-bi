    "question": "按每个SKU和仓库各自最新快照，汇总各产品型号的期末库存数量，不要跨日期累加库存。",
    "sql": "WITH \"latest_snapshot\" AS (SELECT \"f\".\"sku_id\" AS \"sku_id\", \"f\".\"warehouse_id\" AS \"warehouse_id\", \"f\".\"quantity\" AS \"quantity\", \"f\".\"stock_date\" AS \"stock_date\", ROW_NUMBER() OVER (PARTITION BY \"f\".\"sku_id\", \"f\".\"warehouse_id\" ORDER BY \"f\".\"stock_date\" DESC) AS \"rn\" FROM \"fact_inventory_day\" AS \"f\") SELECT \"p\".\"product_id\" AS \"product_id\", \"p\".\"product_name\" AS \"product_name\", SUM(\"l\".\"quantity\") AS \"total_inventory\" FROM \"latest_snapshot\" AS \"l\" JOIN \"dim_sku\" AS \"s\" ON \"l\".\"sku_id\" = \"s\".\"sku_id\" JOIN \"dim_product\" AS \"p\" ON \"s\".\"product_id\" = \"p\".\"product_id\" WHERE \"l\".\"rn\" = 1 GROUP BY \"p\".\"product_id\", \"p\".\"product_name\" ORDER BY \"product_id\" LIMIT 1001",
