        "truncated": false,
        "question": "2026年5月我能查看的设备，按产品型号计算设备日离线率，返回型号名称、总设备日样本量和百分数；online=0算离线。",
        "sql": "SELECT \"dp\".\"product_name\" AS \"product_name\", COUNT(*) AS \"total_device_days\", ROUND(100.0 * SUM(CASE WHEN \"fdd\".\"online\" = 0 THEN 1 ELSE 0 END) / COUNT(*), 2) AS \"offline_rate_percent\" FROM \"fact_device_day\" AS \"fdd\" INNER JOIN \"dim_device\" AS \"dd\" ON \"fdd\".\"device_id\" = \"dd\".\"device_id\" INNER JOIN \"dim_product\" AS \"dp\" ON \"dd\".\"product_id\" = \"dp\".\"product_id\" WHERE \"fdd\".\"event_date\" >= CAST('2026-05-01' AS DATE) AND \"fdd\".\"event_date\" < CAST('2026-06-01' AS DATE) GROUP BY \"dp\".\"product_name\" ORDER BY \"product_name\" LIMIT 1001",
