        "truncated": false,
        "question": "2026年9月我权限内售出设备按型号计算30天激活率，只纳入观察满30天的设备，未激活和晚激活留在分母，列出设备分母、激活分子和百分数。",
        "sql": "WITH \"cohort\" AS (SELECT \"b\".\"device_id\" AS \"device_id\", \"p\".\"product_name\" AS \"product_name\" FROM \"fact_order\" AS \"o\" JOIN \"fact_order_item\" AS \"i\" ON \"o\".\"order_id\" = \"i\".\"order_id\" JOIN \"bridge_order_device\" AS \"b\" ON \"i\".\"item_id\" = \"b\".\"item_id\" JOIN \"dim_device\" AS \"d\" ON \"b\".\"device_id\" = \"d\".\"device_id\" JOIN \"dim_product\" AS \"p\" ON \"d\".\"product_id\" = \"p\".\"product_id\" WHERE \"o\".\"paid_date\" >= CAST('2026-09-01' AS DATE) AND \"o\".\"paid_date\" <= CAST('2026-09-16' AS DATE)), \"activation\" AS (SELECT \"b\".\"device_id\" AS \"device_id\", \"a\".\"activation_date\" AS \"activation_date\" FROM \"bridge_order_device\" AS \"b\" JOIN \"fact_device_activation\" AS \"a\" ON \"b\".\"device_id\" = \"a\".\"device_id\" WHERE \"a\".\"activation_date\" <= CAST('2026-10-16' AS DATE)) SELECT \"c\".\"product_name\" AS \"product_name\", COUNT(DISTINCT \"c\".\"device_id\") AS \"devices\", COUNT(DISTINCT CASE WHEN NOT \"a\".\"activation_date\" IS NULL THEN \"c\".\"device_id\" END) AS \"matched_devices\", CASE WHEN COUNT(DISTINCT \"c\".\"device_id\") = 0 THEN NULL ELSE ROUND(COUNT(DISTINCT CASE WHEN NOT \"a\".\"activation_date\" IS NULL THEN \"c\".\"device_id\" END) * 100.0 / COUNT(DISTINCT \"c\".\"device_id\"), 2) END AS \"rate_percent\" FROM \"cohort\" AS \"c\" LEFT JOIN \"activation\" AS \"a\" ON \"c\".\"device_id\" = \"a\".\"device_id\" GROUP BY \"c\".\"product_name\" ORDER BY \"product_name\" LIMIT 1001",
